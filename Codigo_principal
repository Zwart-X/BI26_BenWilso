# ## 10. Aplicar a Múltiples Imágenes (mini batch)
 
# %%
def full_filter_pipeline(img_rgb, clip=2.0, sigma=1.5, D1=15, D2=60):
    """
    Retorna: mask_pred (binaria), img_masked (RGB con fondo negro)
    """
    H        = get_hematoxylin(img_rgb)
    H_clahe  = apply_clahe(H, clip=clip)
    H_gauss  = apply_gaussian(H_clahe, sigma=sigma)
    H_bp     = bandpass_fft(H_gauss, D1=D1, D2=D2)
    mask     = otsu_mask(H_bp)
    masked   = (img_rgb * np.stack([mask]*3, axis=-1)).astype(np.uint8)
    return mask, masked
 
