print(f"Test : {len(test_imgs)}  imgs | {len(test_masks)}  masks")
 
# %%
def load_img(path):
    img = cv2.imread(path, cv2.IMREAD_COLOR)
    if img is None:
        img = np.array(Image.open(path).convert('RGB'))
    else:
        img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)
    return img
 
def load_mask(path):
    m = cv2.imread(path, cv2.IMREAD_GRAYSCALE)
    if m is None:
        m = np.array(Image.open(path).convert('L'))
    return (m > 0).astype(np.uint8)
 
IMG_SIZE = (256, 256)
 
# Cargar un par de ejemplo
img_raw  = cv2.resize(load_img(train_imgs[0]),   IMG_SIZE)
mask_gt  = cv2.resize(load_mask(train_masks[0]), IMG_SIZE,
                       interpolation=cv2.INTER_NEAREST)
 
