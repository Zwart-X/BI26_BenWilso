# ## 2. Deconvolución de Color — Canal Hematoxilina
#
# rgb2hed retorna OD (densidad óptica): mayor OD = más tinción.
# Núcleos absorben más hematoxilina → valores H altos.
# Sin embargo la normalización necesita inversión para que
# "más hematoxilina = valor más alto" en la imagen resultante.

def get_hematoxylin(img_rgb):
    hed    = color.rgb2hed(img_rgb.astype(np.float64) / 255.0)
    H      = hed[:, :, 0]
    H_norm = (H - H.min()) / (H.max() - H.min() + 1e-8)
    H_norm = 1 - H_norm   # ← FIX: núcleos → valores altos (brillantes)
    return H_norm.astype(np.float32)

H = get_hematoxylin(img_raw)

# ## 3. CLAHE
#
# Ventana 8×8, clip β = 2.0 — normaliza variaciones de iluminación
# entre centro y bordes sin amplificar artefactos del escáner.
 
# %%
def apply_clahe(img_float, clip=2.0, tile=(8, 8)):
    u8    = (img_float * 255).clip(0, 255).astype(np.uint8)
    clahe = cv2.createCLAHE(clipLimit=clip, tileGridSize=tile)
    return clahe.apply(u8).astype(np.float32) / 255.0
 
H_clahe = apply_clahe(H)

# ## 4. Filtro Gaussiano Espacial
#
# σ = 1.5, kernel 5×5 — elimina ruido de alta frecuencia
# antes de calcular la FFT para evitar artefactos espectrales.
 
def apply_gaussian(img, sigma=0.5):   # 0.8 → 0.5
    return filters.gaussian(img, sigma=sigma).astype(np.float32)

H_gauss = apply_gaussian(H_clahe)

# ## 5. Filtro Pasa-Banda en Dominio Frecuencial
#
#   Fc(u,v) = FFT{ H(x,y)·(-1)^(x+y) }     ← centra DC en [N/2, M/2]
#   H_BP(u,v) = 1  si  D1 < D(u,v) ≤ D2
#   H_bp(x,y) = Re{ iFFT{ Fc · H_BP } }·(-1)^(x+y)
#
# D1=15, D2=60 → rango calibrado para núcleos MoNuSeg a 40×.

def bandpass_fft(img, D1=15, D2=60):
    rows, cols = img.shape

    # Máscara de centrado (-1)^(x+y)  →  DC queda en índice [rows//2, cols//2]
    x, y  = np.meshgrid(np.arange(cols), np.arange(rows))
    shift = (-1.0) ** (x + y)

    # FFT 2D con espectro desplazado
    F = np.fft.fft2(img * shift)

    # ── FIX ──────────────────────────────────────────────────────────────────
    # Coordenadas centradas en [rows//2, cols//2]  (donde está el DC tras shift)
    u = np.arange(rows) - rows // 2   # u[rows//2] = 0  ← DC
    v = np.arange(cols) - cols // 2
    # ─────────────────────────────────────────────────────────────────────────
    V, U = np.meshgrid(v, u)
    D    = np.sqrt(U**2 + V**2)

    # Máscara anular ideal
    H_BP = ((D > D1) & (D <= D2)).astype(np.float64)

    # IFFT + re-centrado
    out = np.real(np.fft.ifft2(F * H_BP)) * shift
    out = (out - out.min()) / (out.max() - out.min() + 1e-8)
    return out.astype(np.float32)

H_bp = bandpass_fft(H_gauss)

# ## 6. Umbralización de Otsu → Máscara Binaria
#
# Después del bandpass los núcleos son oscuros → están POR DEBAJO del umbral.

def otsu_mask(img_float):
    u8     = (img_float * 255).clip(0, 255).astype(np.uint8)
    thresh = filters.threshold_otsu(u8)
    return (u8 < thresh).astype(np.uint8)   # ← FIX: < en vez de >

mask_pred = otsu_mask(H_bp)

# ## 6b. Postprocesamiento Morfológico
#
# 1. Cierre  (r=2): rellena huecos internos en núcleos
# 2. Apertura (r=1): elimina manchas sub-nucleares espurias
# 3. Elimina componentes < 20 px² (ruido residual)

from skimage import morphology

def morpho_clean(binary, close_r=1, open_r=1, min_size=20):  # close_r: 2→1
    mask = binary.astype(bool)
    mask = morphology.binary_closing(mask, morphology.disk(close_r))
    mask = morphology.binary_opening(mask,  morphology.disk(open_r))
    mask = morphology.remove_small_objects(mask, min_size=min_size)
    return mask.astype(np.uint8)

mask_pred = morpho_clean(mask_pred)

# ## 6c. Watershed — Separación de Instancias
#
# DT(x,y) = distancia euclidiana al borde más cercano
# Máximos locales de DT → marcadores semilla (1 por núcleo)
# Watershed sobre -DT → cada cuenca = 1 núcleo individual

from scipy import ndimage as ndi
from skimage.feature import peak_local_max
from skimage import segmentation

# ## 6c. Watershed sobre canal Hematoxilina (no sobre DT binario)
#
# Cambio clave: la superficie es H invertida, no DT del binario.
# Dentro de un blob fusionado, H sigue mostrando N mínimos (N núcleos).
# → Watershed puede separarlos aunque el binario los haya unido.

def watershed_instances(binary, h_channel, min_distance=3, sigma_surf=0.5):
    # Invertir H: centros de núcleos (oscuros) → máximos locales
    surface = filters.gaussian(1.0 - h_channel, sigma=sigma_surf)

    # Semillas = máximos locales dentro de la máscara binaria
    coords  = peak_local_max(surface, min_distance=min_distance,
                              labels=binary.astype(bool))
    markers = np.zeros_like(binary, dtype=np.int32)
    if len(coords) > 0:
        markers[tuple(coords.T)] = 1
    markers, _ = ndi.label(markers)

    # Watershed sobre la superficie de intensidad (no sobre -DT)
    labeled = segmentation.watershed(-surface, markers,
                                      mask=binary.astype(bool))
    return labeled

# ← Ahora pasamos H_clahe como superficie
labeled = watershed_instances(mask_pred, H_clahe)
