# ## Dataset PyTorch para U-Net
# Entrada:  imagen RGB normalizada (ImageNet stats)
# Salida:   máscara binaria float [0,1]
# Augmentación básica: flips + rotación 90°

import torch
import torch.nn as nn
import torch.nn.functional as F
from torch.utils.data import Dataset, DataLoader
from torchvision import transforms

DEVICE = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
print(f"Device: {DEVICE}")

IMG_MEAN = [0.485, 0.456, 0.406]
IMG_STD  = [0.229, 0.224, 0.225]

class NucleiDataset(Dataset):
    def __init__(self, img_paths, mask_paths, size=(256,256), augment=False):
        self.imgs    = img_paths
        self.masks   = mask_paths
        self.size    = size
        self.augment = augment
        self.to_tensor = transforms.Compose([
            transforms.ToTensor(),
            transforms.Normalize(IMG_MEAN, IMG_STD),
        ])

    def __len__(self):
        return len(self.imgs)

    def __getitem__(self, idx):
        img  = cv2.resize(load_img(self.imgs[idx]),   self.size)
        mask = cv2.resize(load_mask(self.masks[idx]), self.size,
                          interpolation=cv2.INTER_NEAREST)
        if self.augment:
            if np.random.rand() > 0.5:
                img, mask = np.fliplr(img).copy(),  np.fliplr(mask).copy()
            if np.random.rand() > 0.5:
                img, mask = np.flipud(img).copy(),  np.flipud(mask).copy()
            k = np.random.randint(4)
            if k: img, mask = np.rot90(img,k).copy(), np.rot90(mask,k).copy()

        return (self.to_tensor(img),
                torch.from_numpy(mask.astype(np.float32)).unsqueeze(0))

# DataLoaders
train_ds = NucleiDataset(train_imgs, train_masks, augment=True)
test_ds  = NucleiDataset(test_imgs,  test_masks,  augment=False)
train_dl = DataLoader(train_ds, batch_size=4, shuffle=True,
                      num_workers=2, pin_memory=True)
test_dl  = DataLoader(test_ds,  batch_size=1, shuffle=False,
                      num_workers=2, pin_memory=True)

# Verificar
imgs, masks = next(iter(train_dl))
print(f"Batch imágenes: {imgs.shape}   Batch máscaras: {masks.shape}")
print(f"Train: {len(train_ds)} | Test: {len(test_ds)}")

# ## U-Net — Encoder-Decoder con Skip Connections
# Entrada:  (B, 3, 256, 256)  RGB normalizado
# Salida:   (B, 1, 256, 256)  logits → sigmoid = probabilidad núcleo

class DoubleConv(nn.Module):
    def __init__(self, in_ch, out_ch):
        super().__init__()
        self.net = nn.Sequential(
            nn.Conv2d(in_ch,  out_ch, 3, padding=1, bias=False),
            nn.BatchNorm2d(out_ch), nn.ReLU(inplace=True),
            nn.Conv2d(out_ch, out_ch, 3, padding=1, bias=False),
            nn.BatchNorm2d(out_ch), nn.ReLU(inplace=True),
        )
    def forward(self, x): return self.net(x)

class Down(nn.Module):
    def __init__(self, in_ch, out_ch):
        super().__init__()
        self.net = nn.Sequential(nn.MaxPool2d(2), DoubleConv(in_ch, out_ch))
    def forward(self, x): return self.net(x)

class Up(nn.Module):
    def __init__(self, in_ch, out_ch):
        super().__init__()
        self.up   = nn.ConvTranspose2d(in_ch, in_ch//2, 2, stride=2)
        self.conv = DoubleConv(in_ch, out_ch)
    def forward(self, x, skip):
        x = self.up(x)
        dy = skip.size(2) - x.size(2)
        dx = skip.size(3) - x.size(3)
        x  = F.pad(x, [dx//2, dx-dx//2, dy//2, dy-dy//2])
        return self.conv(torch.cat([skip, x], dim=1))

class UNet(nn.Module):
    def __init__(self, in_ch=3, base=64):
        super().__init__()
        b = base
        self.enc1 = DoubleConv(in_ch, b)
        self.enc2 = Down(b,   b*2)
        self.enc3 = Down(b*2, b*4)
        self.enc4 = Down(b*4, b*8)
        self.bot  = Down(b*8, b*16)
        self.dec4 = Up(b*16, b*8)
        self.dec3 = Up(b*8,  b*4)
        self.dec2 = Up(b*4,  b*2)
        self.dec1 = Up(b*2,  b)
        self.head = nn.Conv2d(b, 1, 1)

    def forward(self, x):
        e1 = self.enc1(x)
        e2 = self.enc2(e1)
        e3 = self.enc3(e2)
        e4 = self.enc4(e3)
        b  = self.bot(e4)
        x  = self.dec4(b,  e4)
        x  = self.dec3(x,  e3)
        x  = self.dec2(x,  e2)
        x  = self.dec1(x,  e1)
        return self.head(x)

# Verificar
model  = UNet().to(DEVICE)
dummy  = torch.zeros(1, 3, 256, 256).to(DEVICE)
out    = model(dummy)
params = sum(p.numel() for p in model.parameters() if p.requires_grad)
print(f"Output shape: {out.shape}")
print(f"Parámetros entrenables: {params:,}")

# ## Loss BCE + Dice  +  Training Loop

class BCEDiceLoss(nn.Module):
    def __init__(self, alpha=0.5, smooth=1.0):
        super().__init__()
        self.alpha  = alpha
        self.smooth = smooth
        self.bce    = nn.BCEWithLogitsLoss()

    def forward(self, logits, targets):
        bce  = self.bce(logits, targets)
        prob = torch.sigmoid(logits)
        inter = (prob * targets).sum(dim=(1,2,3))
        denom = prob.sum(dim=(1,2,3)) + targets.sum(dim=(1,2,3))
        dice  = 1 - (2*inter + self.smooth) / (denom + self.smooth)
        return self.alpha * bce + (1-self.alpha) * dice.mean()

# ── Configuración ──────────────────────────────────────────
EPOCHS = 50
LR     = 1e-3

criterion = BCEDiceLoss(alpha=0.5)
optimizer = torch.optim.Adam(model.parameters(), lr=LR, weight_decay=1e-5)
scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(
                optimizer, mode='min', patience=7, factor=0.5, verbose=True)

# ── Funciones de época ─────────────────────────────────────
def train_epoch(model, loader, opt, loss_fn):
    model.train()
    total = 0.0
    for imgs, masks in loader:
        imgs, masks = imgs.to(DEVICE), masks.to(DEVICE)
        opt.zero_grad()
        loss = loss_fn(model(imgs), masks)
        loss.backward()
        opt.step()
        total += loss.item()
    return total / len(loader)

@torch.no_grad()
def eval_epoch(model, loader, loss_fn):
    model.eval()
    total, dices = 0.0, []
    for imgs, masks in loader:
        imgs, masks = imgs.to(DEVICE), masks.to(DEVICE)
        logits = model(imgs)
        total += loss_fn(logits, masks).item()
        pred   = (torch.sigmoid(logits) > 0.5).float()
        inter  = (pred * masks).sum(dim=(1,2,3))
        denom  = pred.sum(dim=(1,2,3)) + masks.sum(dim=(1,2,3))
        dices.extend(((2*inter+1)/(denom+1)).cpu().tolist())
    return total / len(loader), float(np.mean(dices))

# ── Loop principal ─────────────────────────────────────────
history   = {'train_loss': [], 'val_loss': [], 'val_dice': []}
best_dice = 0.0
SAVE_PATH = '/kaggle/working/best_unet.pth'

print(f"Entrenando {EPOCHS} épocas en {DEVICE}...")
for epoch in range(1, EPOCHS+1):
    tl       = train_epoch(model, train_dl, optimizer, criterion)
    vl, vd   = eval_epoch(model, test_dl, criterion)
    scheduler.step(vl)

    history['train_loss'].append(tl)
    history['val_loss'].append(vl)
    history['val_dice'].append(vd)

    if vd > best_dice:
        best_dice = vd
        torch.save(model.state_dict(), SAVE_PATH)

    if epoch % 10 == 0 or epoch == 1:
        print(f"Ep {epoch:3d}/{EPOCHS}  "
              f"TrainLoss={tl:.4f}  ValLoss={vl:.4f}  "
              f"ValDice={vd:.4f}  Best={best_dice:.4f}")

print(f"\n✓ Mejor Dice: {best_dice:.4f}  →  guardado en {SAVE_PATH}")

# Curvas
