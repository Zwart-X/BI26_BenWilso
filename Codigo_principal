import os
 
def get_paths(root):
    train_imgs, train_masks = [], []
    test_imgs,  test_masks  = [], []
    exts = ('.tif', '.tiff', '.png', '.jpg')
 
    for dirpath, _, files in os.walk(root):
        d = dirpath.lower()
        for f in sorted(files):
            if not any(f.lower().endswith(e) for e in exts):
                continue
            full = os.path.join(dirpath, f)
            if   'train' in d and 'image' in d:  train_imgs.append(full)
            elif 'train' in d and 'mask'  in d:  train_masks.append(full)
            elif 'test'  in d and 'image' in d:  test_imgs.append(full)
            elif 'test'  in d and 'mask'  in d:  test_masks.append(full)
 
    return (sorted(set(train_imgs)), sorted(set(train_masks)),
            sorted(set(test_imgs)),  sorted(set(test_masks)))
 
train_imgs, train_masks, test_imgs, test_masks = get_paths('/kaggle/input')
 
